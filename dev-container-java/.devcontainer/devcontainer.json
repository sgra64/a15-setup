{
  // use official Temurin-image with pre-installed JDK 25
  "name": "Java-25 (openjdk-25)",
  "image": "eclipse-temurin:25-jdk",

  // https://code.visualstudio.com/remote/advancedcontainers/change-default-source-mount
  // https://dev.to/graezykev/dev-containers-part-2-image-features-workspace-environment-variables-375o
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",

  // reuse named container
  "runArgs": ["--name=dev-container-openjdk25"],

  // VSCode extensions and customizations
  "customizations": {
    "vscode": {
      "settings": {
        // Java and debug settings
        "java.import.gradle.enabled": false,
        "java.import.maven.enabled": false,
        "java.autobuild.enabled": false,    // disable publishing diagnistics
        "java.jdt.ls.vmargs": "-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8",
        "java.debug.settings.onBuildFailureProceed": true,
        "java.debug.settings.showHex": true,
        "java.debug.settings.vmArgs": "-Dfile.encoding=UTF-8",
        "java.debug.settings.console": "integratedTerminal",
        "java.output.path": "target/classes",

        // define custom profile for the terminal launched from the container
        "terminal.integrated.profiles.linux": {
            "bash": {
            "path": "/bin/bash",
            // --init-file forces to load a custom script instead of .bashrc
            "args": ["--init-file", "${containerWorkspaceFolder}/.devcontainer/.termrc"]
            }
        },
        // use this profile when a new terminal opens in container
        "terminal.integrated.defaultProfile.linux": "bash",

        // Code Runner settings
        "code-runner.defaultLanguage": "java",
        "code-runner.clearPreviousOutput": true,
        "code-runner.saveAllFilesBeforeRun": true,
        "code-runner.runInTerminal": true,  // avoid UTF-8 problem in OUTPUT console on Windows
        "code-runner.executorMap": {
            "java": "javac -d target/classes HelloWorld.java && java -cp target/classes HelloWorld",
            // "java": "javac -d target/classes src/**/*.java && java HelloWorld",
            // "java": "java -cp @.vscode/.classpath application.Application",
            "vmArgs": "-Dfile.encoding=UTF-8"
        },

        // Editor settings
        "editor.detectIndentation": false,
        "editor.tabSize": 4,                    // use 4-space tabs
        "editor.insertSpaces": true,            // insert spaces for tabs
        "editor.renderWhitespace": "all",       // show white spaces in editor as small dots ("none", "boundary", "selection", "trailing", "all")
        "editor.hover.enabled": "on",           // show context when hovering
        "editor.hover.delay": 1500,             // delay hover-time for context pop-ups (in ms)
        "editor.minimap.enabled": false,        // show minimap for long files
        "editor.inlayHints.enabled": "off",     // don't show argument names in method calls

        // other settings
        "explorer.confirmDelete": false,        // ask to comfirm file delete
        "files.autoSave": "afterDelay",         // 'afterDelay' (1sec), 'onFocusChange', 'onWindowChange'
        "files.autoSaveDelay": 800,
        "files.encoding": "utf8",
        "files.eol": "\n"                       // use '\n' as default line ending (not: CR/LF)
      },

      // add extensions to dev-container
      "extensions": [
        "vscjava.vscode-java-pack",
        "formulahendry.code-runner"
      ]
    }
  },

  // add features to container
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
    // "ghcr.io/devcontainers/features/common-utils:2": {} // optional für zsh, curl, etc.
  },

  // start container as root-User (Alpine-standard)
  "remoteUser": "root"
}
